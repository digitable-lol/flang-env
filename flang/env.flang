модуль «Env»

// Разбор ЗНАЧЕНИЙ окружения, а не чтение его. Хозяин передаёт строки —
// библиотека решает: сколько цвета терпит терминал, на каком языке говорить и
// какими знаками писать числа.
//
// ЗДЕСЬ НЕТ НИ ОДНОГО ПОРУЧЕНИЯ. Всё, что ниже, — тотальные функции, и потому
// весь модуль печатается в Go и в C и уезжает ВНУТРЬ чужого двоичного файла.
// Тот, кому нужно, чтобы окружение прочла сама библиотека, берёт план из
// `flang/read-env.flang` и исполняет его `flang io`; граница между двумя
// слоями объяснена в README числом и дословной цитатой отказа компилятора.
//
// ПОЧЕМУ ПЕРЕМЕННАЯ — ЭТО СУММА, А НЕ СТРОКА. `NO_COLOR` действует самим
// СВОИМ НАЛИЧИЕМ: no-color.org требует уважать даже пустое значение, и эталон
// (digitdisk, host/internal/ui/theme.go) спрашивает про него `os.LookupEnv`,
// а не `os.Getenv`. Пустая строка и отсутствие — разные вещи, и тип это знает.

тип «Значение среды»
  вариант «Задано» содержит значение: строка
  вариант «Не задано»

тотальная функция «Задано ли»
  принимает переменная: «Значение среды»
  возвращает признак
  пример «Задано»
    дано переменная равно (вариант «Задано» с значение равным "1")
    ожидается да
  пример «Задано пустым — всё равно задано»
    дано переменная равно (вариант «Задано» с значение равным "")
    ожидается да
  пример «Не задано»
    дано переменная равно вариант «Не задано»
    ожидается нет
  разбор переменная
    случай вариант «Задано» с значение как значение
      то да
    случай вариант «Не задано»
      то нет

тотальная функция «Значением или пустым»
  принимает переменная: «Значение среды»
  возвращает строка
  пример «Задано»
    дано переменная равно (вариант «Задано» с значение равным "xterm")
    ожидается "xterm"
  пример «Не задано — пустая строка, как у os.Getenv»
    дано переменная равно вариант «Не задано»
    ожидается ""
  разбор переменная
    случай вариант «Задано» с значение как значение
      то значение
    случай вариант «Не задано»
      то ""

// ─────────────────────────── строковая мелочь ───────────────────────────

тотальная функция «Пробельный»
  принимает знак: строка
  возвращает признак
  пример «Пробел»
    дано знак равно " "
    ожидается да
  пример «Буква»
    дано знак равно "e"
    ожидается нет
  разбор знак
    случай пусто
      то нет
    случай голова и хвост
      то ((код символа голова) равен 32) или ((код символа голова) равен 9) или ((код символа голова) равен 10) или ((код символа голова) равен 11) или ((код символа голова) равен 12) или ((код символа голова) равен 13) или ((код символа голова) равен 133) или ((код символа голова) равен 160)

тотальная функция «Обратно»
  принимает текст: строка
  возвращает строка
  обеспечивает «длина не меняется» (длина результат) равен (длина текст)
  пример «Наоборот»
    дано текст равно "abc"
    ожидается "cba"
  разбор текст
    случай пусто
      то ""
    случай голова и хвост
      то соединить («Обратно» от хвост) с голова

тотальная функция «Слева обрезать»
  принимает текст: строка
  возвращает строка
  обеспечивает «длиннее исходного не бывает» (длина результат) не больше (длина текст)
  пример «Пробелы слева уходят»
    дано текст равно "  ru_RU"
    ожидается "ru_RU"
  пример «Одни пробелы — пусто»
    дано текст равно "   "
    ожидается ""
  разбор текст
    случай пусто
      то ""
    случай голова и хвост
      то если («Пробельный» от голова) то («Слева обрезать» от хвост) иначе текст

тотальная функция «Обрезать пробелы»
  принимает текст: строка
  возвращает строка
  обеспечивает «длиннее исходного не бывает» (длина результат) не больше (длина текст)
  пример «С обеих сторон»
    дано текст равно "  ru_RU.UTF-8  "
    ожидается "ru_RU.UTF-8"
  пример «Пустое остаётся пустым»
    дано текст равно ""
    ожидается ""
  «Обратно» от («Слева обрезать» от («Обратно» от («Слева обрезать» от текст)))

тотальная функция «Знак в нижний»
  принимает знак: строка
  возвращает строка
  пример «Большая латинская»
    дано знак равно "T"
    ожидается "t"
  пример «Кириллица не трогается: таблица здесь только латинская»
    дано знак равно "Р"
    ожидается "Р"
  разбор знак
    случай пусто
      то ""
    случай голова и хвост
      то если ((код символа голова) не меньше 65) и притом ((код символа голова) не больше 90) то (символ по коду ((код символа голова) плюс 32)) иначе голова

// ToLower у Go знает весь Unicode; здесь — только латиница ASCII, и это
// НАЗВАНО, а не умолчано. Все слова, по которым идёт разбор ниже — `truecolor`,
// `24bit`, `dumb`, `direct`, `256`, `paper`, `signal`, коды языков — латинские.
тотальная функция «В нижний регистр»
  принимает текст: строка
  возвращает строка
  обеспечивает «длина не меняется» (длина результат) равен (длина текст)
  пример «Смешанный регистр»
    дано текст равно "TrueColor"
    ожидается "truecolor"
  соединить (отобразить (разложить текст на символы) как знак → «Знак в нижний» от знак) по ""

тотальная функция «До знака»
  принимает текст: строка, знак: строка
  возвращает строка
  обеспечивает «длиннее исходного не бывает» (длина результат) не больше (длина текст)
  пример «Есть знак»
    дано текст равно "ru_RU.UTF-8"
    дано знак равно "."
    ожидается "ru_RU"
  пример «Нет знака»
    дано текст равно "ru_RU"
    дано знак равно "."
    ожидается "ru_RU"
  пример «Пустой текст»
    дано текст равно ""
    дано знак равно "."
    ожидается ""
  если (длина текст) равен 0
    то ""
    иначе элемент 1 в (разделить текст по знак)

тотальная функция «После знака»
  принимает текст: строка, знак: строка
  возвращает строка
  пример «Есть знак»
    дано текст равно "ru_RU.UTF-8"
    дано знак равно "."
    ожидается "UTF-8"
  пример «Нет знака — пусто»
    дано текст равно "ru_RU"
    дано знак равно "."
    ожидается ""
  если (длина текст) равен 0
    то ""
    иначе
      пусть куски равно (разделить текст по знак)
      если (длина куски) не больше 1 то "" иначе (элемент 2 в куски)

// ─────────────────────────── глубина цвета ───────────────────────────

тип «Глубина цвета»
  вариант «Без цвета»
  вариант «Шестнадцать»
  вариант «Двести пятьдесят шесть»
  вариант «Истинный цвет»

// Дословно detectDepth из host/internal/ui/theme.go: NO_COLOR по НАЛИЧИЮ,
// пустой и `dumb` терминал без цвета, COLORTERM в нижнем регистре, потом
// подстроки `direct` и `256` в самом TERM.
тотальная функция «Глубина цвета»
  принимает «без цвета»: «Значение среды», терминал: «Значение среды», «цветной терминал»: «Значение среды»
  возвращает «Глубина цвета»
  пример «NO_COLOR действует даже пустым»
    дано «без цвета» равно (вариант «Задано» с значение равным "")
    дано терминал равно (вариант «Задано» с значение равным "xterm-256color")
    дано «цветной терминал» равно (вариант «Задано» с значение равным "truecolor")
    ожидается вариант «Без цвета»
  пример «Пустой TERM — без цвета»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно вариант «Не задано»
    дано «цветной терминал» равно вариант «Не задано»
    ожидается вариант «Без цвета»
  пример «dumb — без цвета»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "dumb")
    дано «цветной терминал» равно вариант «Не задано»
    ожидается вариант «Без цвета»
  пример «COLORTERM=truecolor — истинный цвет»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "xterm")
    дано «цветной терминал» равно (вариант «Задано» с значение равным "TrueColor")
    ожидается вариант «Истинный цвет»
  пример «COLORTERM=24bit — истинный цвет»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "xterm")
    дано «цветной терминал» равно (вариант «Задано» с значение равным "24bit")
    ожидается вариант «Истинный цвет»
  пример «TERM с direct — истинный цвет»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "xterm-direct")
    дано «цветной терминал» равно вариант «Не задано»
    ожидается вариант «Истинный цвет»
  пример «TERM с 256 — палитра»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "screen-256color")
    дано «цветной терминал» равно вариант «Не задано»
    ожидается вариант «Двести пятьдесят шесть»
  пример «Обычный xterm — шестнадцать»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "xterm")
    дано «цветной терминал» равно вариант «Не задано»
    ожидается вариант «Шестнадцать»
  // Примеры ниже сняты с эталона digitdisk 7ea03ed: входы выбраны по границам, ответы — его.
  пример «NO_COLOR не задан, TERM не задан, COLORTERM не задан»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно вариант «Не задано»
    дано «цветной терминал» равно вариант «Не задано»
    ожидается вариант «Без цвета»
  пример «NO_COLOR = "", TERM = "xterm-256color", COLORTERM = "truecolor"»
    дано «без цвета» равно (вариант «Задано» с значение равным "")
    дано терминал равно (вариант «Задано» с значение равным "xterm-256color")
    дано «цветной терминал» равно (вариант «Задано» с значение равным "truecolor")
    ожидается вариант «Без цвета»
  пример «NO_COLOR = "1", TERM = "xterm-256color", COLORTERM = "truecolor"»
    дано «без цвета» равно (вариант «Задано» с значение равным "1")
    дано терминал равно (вариант «Задано» с значение равным "xterm-256color")
    дано «цветной терминал» равно (вариант «Задано» с значение равным "truecolor")
    ожидается вариант «Без цвета»
  пример «NO_COLOR = "0", TERM = "xterm-direct", COLORTERM не задан»
    дано «без цвета» равно (вариант «Задано» с значение равным "0")
    дано терминал равно (вариант «Задано» с значение равным "xterm-direct")
    дано «цветной терминал» равно вариант «Не задано»
    ожидается вариант «Без цвета»
  пример «NO_COLOR не задан, TERM = "", COLORTERM не задан»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "")
    дано «цветной терминал» равно вариант «Не задано»
    ожидается вариант «Без цвета»
  пример «NO_COLOR не задан, TERM = "dumb", COLORTERM не задан»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "dumb")
    дано «цветной терминал» равно вариант «Не задано»
    ожидается вариант «Без цвета»
  пример «NO_COLOR не задан, TERM = "Dumb", COLORTERM не задан»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "Dumb")
    дано «цветной терминал» равно вариант «Не задано»
    ожидается вариант «Шестнадцать»
  пример «NO_COLOR не задан, TERM = "xterm", COLORTERM не задан»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "xterm")
    дано «цветной терминал» равно вариант «Не задано»
    ожидается вариант «Шестнадцать»
  пример «NO_COLOR не задан, TERM = "linux", COLORTERM не задан»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "linux")
    дано «цветной терминал» равно вариант «Не задано»
    ожидается вариант «Шестнадцать»
  пример «NO_COLOR не задан, TERM = "vt100", COLORTERM не задан»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "vt100")
    дано «цветной терминал» равно вариант «Не задано»
    ожидается вариант «Шестнадцать»
  пример «NO_COLOR не задан, TERM = "xterm-256color", COLORTERM не задан»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "xterm-256color")
    дано «цветной терминал» равно вариант «Не задано»
    ожидается вариант «Двести пятьдесят шесть»
  пример «NO_COLOR не задан, TERM = "screen-256color", COLORTERM не задан»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "screen-256color")
    дано «цветной терминал» равно вариант «Не задано»
    ожидается вариант «Двести пятьдесят шесть»
  пример «NO_COLOR не задан, TERM = "256", COLORTERM не задан»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "256")
    дано «цветной терминал» равно вариант «Не задано»
    ожидается вариант «Двести пятьдесят шесть»
  пример «NO_COLOR не задан, TERM = "direct", COLORTERM не задан»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "direct")
    дано «цветной терминал» равно вариант «Не задано»
    ожидается вариант «Истинный цвет»
  пример «NO_COLOR не задан, TERM = "xterm-direct", COLORTERM не задан»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "xterm-direct")
    дано «цветной терминал» равно вариант «Не задано»
    ожидается вариант «Истинный цвет»
  пример «NO_COLOR не задан, TERM = "xterm", COLORTERM = "truecolor"»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "xterm")
    дано «цветной терминал» равно (вариант «Задано» с значение равным "truecolor")
    ожидается вариант «Истинный цвет»
  пример «NO_COLOR не задан, TERM = "xterm", COLORTERM = "TrueColor"»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "xterm")
    дано «цветной терминал» равно (вариант «Задано» с значение равным "TrueColor")
    ожидается вариант «Истинный цвет»
  пример «NO_COLOR не задан, TERM = "xterm", COLORTERM = "24bit"»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "xterm")
    дано «цветной терминал» равно (вариант «Задано» с значение равным "24bit")
    ожидается вариант «Истинный цвет»
  пример «NO_COLOR не задан, TERM = "xterm", COLORTERM = "24BIT"»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "xterm")
    дано «цветной терминал» равно (вариант «Задано» с значение равным "24BIT")
    ожидается вариант «Истинный цвет»
  пример «NO_COLOR не задан, TERM = "xterm", COLORTERM = "yes"»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "xterm")
    дано «цветной терминал» равно (вариант «Задано» с значение равным "yes")
    ожидается вариант «Шестнадцать»
  пример «NO_COLOR не задан, TERM = "xterm", COLORTERM = "нет"»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "xterm")
    дано «цветной терминал» равно (вариант «Задано» с значение равным "нет")
    ожидается вариант «Шестнадцать»
  пример «NO_COLOR не задан, TERM = "xterm", COLORTERM = ""»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "xterm")
    дано «цветной терминал» равно (вариант «Задано» с значение равным "")
    ожидается вариант «Шестнадцать»
  пример «NO_COLOR не задан, TERM = "dumb", COLORTERM = "truecolor"»
    дано «без цвета» равно вариант «Не задано»
    дано терминал равно (вариант «Задано» с значение равным "dumb")
    дано «цветной терминал» равно (вариант «Задано» с значение равным "truecolor")
    ожидается вариант «Без цвета»
  пусть терм равно («Значением или пустым» от терминал)
  если («Задано ли» от «без цвета»)
    то вариант «Без цвета»
    иначе если ((длина терм) равен 0) или (терм равен "dumb")
      то вариант «Без цвета»
      иначе если («В нижний регистр» от («Значением или пустым» от «цветной терминал»)) равен "truecolor"
        то вариант «Истинный цвет»
        иначе если («В нижний регистр» от («Значением или пустым» от «цветной терминал»)) равен "24bit"
          то вариант «Истинный цвет»
          иначе если терм содержит "direct"
            то вариант «Истинный цвет»
            иначе если терм содержит "256"
              то вариант «Двести пятьдесят шесть»
              иначе вариант «Шестнадцать»

// UsableTERM из host/internal/ui/term.go: экран рисуют не всюду.
тотальная функция «Терминал годен»
  принимает терминал: «Значение среды»
  возвращает признак
  пример «Обычный терминал годен»
    дано терминал равно (вариант «Задано» с значение равным "xterm")
    ожидается да
  пример «Пустой не годен»
    дано терминал равно вариант «Не задано»
    ожидается нет
  пример «dumb не годен»
    дано терминал равно (вариант «Задано» с значение равным "dumb")
    ожидается нет
  // Примеры ниже сняты с эталона digitdisk 7ea03ed: входы выбраны по границам, ответы — его.
  пример «TERM не задан»
    дано терминал равно вариант «Не задано»
    ожидается нет
  пример «TERM = ""»
    дано терминал равно (вариант «Задано» с значение равным "")
    ожидается нет
  пример «TERM = "dumb"»
    дано терминал равно (вариант «Задано» с значение равным "dumb")
    ожидается нет
  пример «TERM = "xterm"»
    дано терминал равно (вариант «Задано» с значение равным "xterm")
    ожидается да
  пример «TERM = "DUMB"»
    дано терминал равно (вариант «Задано» с значение равным "DUMB")
    ожидается да
  пример «TERM = " "»
    дано терминал равно (вариант «Задано» с значение равным " ")
    ожидается да
  пусть терм равно («Значением или пустым» от терминал)
  (не ((длина терм) равен 0)) и притом (не (терм равен "dumb"))

// ─────────────────────────── палитра по имени ───────────────────────────

тип «Палитра»
  вариант «Уголь»
  вариант «Бумага»
  вариант «Сигнал»

// PaletteByName: имя чистится от пробелов, опускается в нижний регистр,
// незнакомое даёт палитру по умолчанию.
тотальная функция «Палитра по имени»
  принимает имя: строка
  возвращает «Палитра»
  пример «Бумага»
    дано имя равно " Paper "
    ожидается вариант «Бумага»
  пример «Сигнал»
    дано имя равно "SIGNAL"
    ожидается вариант «Сигнал»
  пример «Незнакомое имя даёт уголь»
    дано имя равно "неон"
    ожидается вариант «Уголь»
  пример «Пустое имя даёт уголь»
    дано имя равно ""
    ожидается вариант «Уголь»
  // Примеры ниже сняты с эталона digitdisk 7ea03ed: входы выбраны по границам, ответы — его.
  пример «""»
    дано имя равно ""
    ожидается вариант «Уголь»
  пример «" "»
    дано имя равно " "
    ожидается вариант «Уголь»
  пример «"paper"»
    дано имя равно "paper"
    ожидается вариант «Бумага»
  пример «"Paper"»
    дано имя равно "Paper"
    ожидается вариант «Бумага»
  пример «" PAPER "»
    дано имя равно " PAPER "
    ожидается вариант «Бумага»
  пример «"signal"»
    дано имя равно "signal"
    ожидается вариант «Сигнал»
  пример «"SIGNAL"»
    дано имя равно "SIGNAL"
    ожидается вариант «Сигнал»
  пример «"carbon"»
    дано имя равно "carbon"
    ожидается вариант «Уголь»
  пример «"Carbon"»
    дано имя равно "Carbon"
    ожидается вариант «Уголь»
  пример «"неон"»
    дано имя равно "неон"
    ожидается вариант «Уголь»
  пример «"papers"»
    дано имя равно "papers"
    ожидается вариант «Уголь»
  пример «"\tsignal\n"»
    дано имя равно "\u0009signal\u000a"
    ожидается вариант «Сигнал»
  пусть чистое равно («В нижний регистр» от («Обрезать пробелы» от имя))
  если чистое равен "paper"
    то вариант «Бумага»
    иначе если чистое равен "signal"
      то вариант «Сигнал»
      иначе вариант «Уголь»

// ─────────────────────────── язык ───────────────────────────

объект «Язык»
  код: строка
  область: строка
  кодировка: строка
  оговорка: строка

// POSIX: `язык[_ОБЛАСТЬ][.кодировка][@оговорка]`. Разбор идёт справа налево —
// сперва отрывается оговорка, потом кодировка, потом область.
тотальная функция «Разобрать язык»
  принимает значение: строка
  возвращает «Язык»
  обеспечивает «код не длиннее исходного» (длина результат.код) не больше (длина значение)
  пример «Полная запись»
    дано значение равно "ru_RU.UTF-8@euro"
    ожидается (запись «Язык» с код равным "ru" и область равным "RU" и кодировка равным "UTF-8" и оговорка равным "euro")
  пример «Только язык и область»
    дано значение равно "en_US"
    ожидается (запись «Язык» с код равным "en" и область равным "US" и кодировка равным "" и оговорка равным "")
  пример «Голая C»
    дано значение равно "C"
    ожидается (запись «Язык» с код равным "C" и область равным "" и кодировка равным "" и оговорка равным "")
  пример «Пустое»
    дано значение равно ""
    ожидается (запись «Язык» с код равным "" и область равным "" и кодировка равным "" и оговорка равным "")
  пусть чистое равно («Обрезать пробелы» от значение)
  пусть «без оговорки» равно («До знака» от чистое и "@")
  пусть «без кодировки» равно («До знака» от «без оговорки» и ".")
  запись «Язык» с код равным («До знака» от «без кодировки» и "_") и область равным («После знака» от «без кодировки» и "_") и кодировка равным («После знака» от «без оговорки» и ".") и оговорка равным («После знака» от чистое и "@")

// Порядок POSIX: LC_ALL сильнее LC_MESSAGES, LC_MESSAGES сильнее LANG.
// Пустое значение не считается заданным — это тоже правило POSIX.
тотальная функция «Первое непустое»
  принимает значения: список строки
  возвращает строка
  пример «Второе непустое»
    дано значения равно ["", "ru_RU.UTF-8", "en_US"]
    ожидается "ru_RU.UTF-8"
  пример «Всё пустое»
    дано значения равно ["", "  "]
    ожидается ""
  свёртка значения начиная с "" как найдено и очередное → (если (длина найдено) больше 0 то найдено иначе («Обрезать пробелы» от очередное))

тотальная функция «Язык среды»
  принимает «всё»: «Значение среды», сообщения: «Значение среды», язык: «Значение среды»
  возвращает «Язык»
  пример «LC_ALL сильнее всех»
    дано «всё» равно (вариант «Задано» с значение равным "de_DE.UTF-8")
    дано сообщения равно (вариант «Задано» с значение равным "ru_RU.UTF-8")
    дано язык равно (вариант «Задано» с значение равным "en_US.UTF-8")
    ожидается (запись «Язык» с код равным "de" и область равным "DE" и кодировка равным "UTF-8" и оговорка равным "")
  пример «Пустой LC_ALL уступает LANG»
    дано «всё» равно (вариант «Задано» с значение равным "")
    дано сообщения равно вариант «Не задано»
    дано язык равно (вариант «Задано» с значение равным "ru_RU.UTF-8")
    ожидается (запись «Язык» с код равным "ru" и область равным "RU" и кодировка равным "UTF-8" и оговорка равным "")
  «Разобрать язык» от («Первое непустое» от [(«Значением или пустым» от «всё»), («Значением или пустым» от сообщения), («Значением или пустым» от язык)])

тотальная функция «Язык без правил»
  принимает язык: «Язык»
  возвращает признак
  пример «C — без правил»
    дано язык равно (запись «Язык» с код равным "C" и область равным "" и кодировка равным "" и оговорка равным "")
    ожидается да
  пример «POSIX — без правил»
    дано язык равно (запись «Язык» с код равным "POSIX" и область равным "" и кодировка равным "" и оговорка равным "")
    ожидается да
  пример «Пусто — без правил»
    дано язык равно (запись «Язык» с код равным "" и область равным "" и кодировка равным "" и оговорка равным "")
    ожидается да
  пример «ru — с правилами»
    дано язык равно (запись «Язык» с код равным "ru" и область равным "RU" и кодировка равным "" и оговорка равным "")
    ожидается нет
  ((длина язык.код) равен 0) или (язык.код равен "C") или (язык.код равен "POSIX")

// ─────────────────────────── правила чисел ───────────────────────────
//
// ЭТАЛОНА У ЭТОЙ ТАБЛИЦЫ НЕТ. `fmt` в Go к языку нечувствителен: digitdisk
// пишет «2.4 ГиБ» всегда с точкой и разрядов не делит вовсе. Таблица ниже —
// НАША, набрана по языкам glibc, и в ведомости README стоит как «объявлено,
// не доказано»: сверить её не с чем, кроме самой glibc.

объект «Правила чисел»
  дробный: строка
  разрядный: строка

тотальная функция «Языки запятой»
  возвращает список строки
  обеспечивает «список не пуст» (длина результат) больше 0
  пример «Тридцать шесть языков, пишущих дробь запятой»
    ожидается ["ru", "uk", "be", "kk", "de", "fr", "es", "it", "pt", "nl", "pl", "tr", "sv", "fi", "da", "nb", "nn", "cs", "sk", "hu", "bg", "ro", "el", "id", "vi", "lv", "lt", "et", "sl", "hr", "sr", "sq", "az", "hy", "ka", "mk"]
  ["ru", "uk", "be", "kk", "de", "fr", "es", "it", "pt", "nl", "pl", "tr", "sv", "fi", "da", "nb", "nn", "cs", "sk", "hu", "bg", "ro", "el", "id", "vi", "lv", "lt", "et", "sl", "hr", "sr", "sq", "az", "hy", "ka", "mk"]

тотальная функция «Языки пробела в разрядах»
  возвращает список строки
  обеспечивает «список не пуст» (длина результат) больше 0
  пример «Языки, делящие разряды пробелом»
    ожидается ["ru", "uk", "be", "kk", "pl", "fr", "cs", "sk", "sv", "fi", "nb", "nn", "hu", "bg", "lv", "lt", "et", "hy", "az", "ka"]
  ["ru", "uk", "be", "kk", "pl", "fr", "cs", "sk", "sv", "fi", "nb", "nn", "hu", "bg", "lv", "lt", "et", "hy", "az", "ka"]

тотальная функция «Правила языка»
  принимает язык: «Язык»
  возвращает «Правила чисел»
  обеспечивает «дробный и разрядный знаки не совпадают» не (результат.дробный равен результат.разрядный)
  пример «C — точка и без разрядов, как у Go»
    дано язык равно (запись «Язык» с код равным "C" и область равным "" и кодировка равным "" и оговорка равным "")
    ожидается (запись «Правила чисел» с дробный равным "." и разрядный равным "")
  пример «Русский — запятая и пробел»
    дано язык равно (запись «Язык» с код равным "ru" и область равным "RU" и кодировка равным "" и оговорка равным "")
    ожидается (запись «Правила чисел» с дробный равным "," и разрядный равным " ")
  пример «Немецкий — запятая и точка»
    дано язык равно (запись «Язык» с код равным "de" и область равным "DE" и кодировка равным "" и оговорка равным "")
    ожидается (запись «Правила чисел» с дробный равным "," и разрядный равным ".")
  пример «Английский — точка и запятая»
    дано язык равно (запись «Язык» с код равным "en" и область равным "US" и кодировка равным "" и оговорка равным "")
    ожидается (запись «Правила чисел» с дробный равным "." и разрядный равным ",")
  если («Язык без правил» от язык)
    то запись «Правила чисел» с дробный равным "." и разрядный равным ""
    иначе если («Языки запятой») содержит язык.код
      то запись «Правила чисел» с дробный равным "," и разрядный равным (если («Языки пробела в разрядах») содержит язык.код то " " иначе ".")
      иначе запись «Правила чисел» с дробный равным "." и разрядный равным ","

тотальная функция «Правила среды»
  принимает «всё»: «Значение среды», сообщения: «Значение среды», язык: «Значение среды»
  возвращает «Правила чисел»
  пример «Русская среда»
    дано «всё» равно вариант «Не задано»
    дано сообщения равно вариант «Не задано»
    дано язык равно (вариант «Задано» с значение равным "ru_RU.UTF-8")
    ожидается (запись «Правила чисел» с дробный равным "," и разрядный равным " ")
  «Правила языка» от («Язык среды» от «всё» и сообщения и язык)

// ─────────────────────────── сводка одной строкой ───────────────────────────
//
// То, чем пользуется план `read-env.flang`: он собирает ШЕСТЬ пометок в том
// порядке, в каком спрашивал, и отдаёт их сюда. Пометка «=значение» означает
// «переменная задана», любая другая — «не задана»; так пустое значение
// (`NO_COLOR=`) не путается с отсутствием, и правило no-color.org живо.

тотальная функция «Из пометки»
  принимает пометка: строка
  возвращает «Значение среды»
  пример «Задано непустым»
    дано пометка равно "=xterm-256color"
    ожидается (вариант «Задано» с значение равным "xterm-256color")
  пример «Задано пустым»
    дано пометка равно "="
    ожидается (вариант «Задано» с значение равным "")
  пример «Не задано»
    дано пометка равно "-"
    ожидается вариант «Не задано»
  если (пометка начинается с "=")
    то вариант «Задано» с значение равным (подстрока пометка с 2 по (длина пометка))
    иначе вариант «Не задано»

тотальная функция «Пометка или прочерк»
  принимает пометки: список строки, номер: число
  возвращает строка
  пример «Внутри списка»
    дано пометки равно ["=1", "-"]
    дано номер равно 1
    ожидается "=1"
  пример «За концом списка»
    дано пометки равно ["=1"]
    дано номер равно 5
    ожидается "-"
  если (номер не меньше 1) и притом (номер не больше (длина пометки))
    то элемент номер в пометки
    иначе "-"

тотальная функция «Название глубины»
  принимает глубина: «Глубина цвета»
  возвращает строка
  пример «Истинный цвет»
    дано глубина равно вариант «Истинный цвет»
    ожидается "истинный цвет"
  разбор глубина
    случай вариант «Без цвета»
      то "без цвета"
    случай вариант «Шестнадцать»
      то "16"
    случай вариант «Двести пятьдесят шесть»
      то "256"
    случай вариант «Истинный цвет»
      то "истинный цвет"

тотальная функция «Сводка среды»
  принимает пометки: список строки
  возвращает строка
  пример «Шесть пометок в порядке спроса»
    дано пометки равно ["-", "=xterm-256color", "-", "-", "-", "=ru_RU.UTF-8"]
    ожидается "цвет: 256; язык: ru; область: RU; дробный: «,»; разрядный: « »"
  пример «Пустого набора хватает: всё неизвестно, и это сказано»
    дано пометки равно пустой список
    ожидается "цвет: без цвета; язык: ; область: ; дробный: «.»; разрядный: «»"
  пусть глубина равно («Глубина цвета» от («Из пометки» от («Пометка или прочерк» от пометки и 1)) и («Из пометки» от («Пометка или прочерк» от пометки и 2)) и («Из пометки» от («Пометка или прочерк» от пометки и 3)))
  пусть язык равно («Язык среды» от («Из пометки» от («Пометка или прочерк» от пометки и 4)) и («Из пометки» от («Пометка или прочерк» от пометки и 5)) и («Из пометки» от («Пометка или прочерк» от пометки и 6)))
  пусть правила равно («Правила языка» от язык)
  соединить [("цвет: "), («Название глубины» от глубина), ("; язык: "), (язык.код), ("; область: "), (язык.область), ("; дробный: «"), (правила.дробный), ("»; разрядный: «"), (правила.разрядный), ("»")] по ""
