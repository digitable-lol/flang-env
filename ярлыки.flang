модуль «Ярлыки»

// ЯРЛЫКИ НА КОМАНДЫ этого дерева — здесь, а не в Makefile.
//
// Ярлык — это имя, за которым стоит строка команды. Строки эти лежали в
// `Makefile`, и звать их приходилось через `make`. make не делал при этом
// ничего сверх подстановки строки: ни одной зависимости между целями здесь не
// было, ни одного правила по времени файла — только `.PHONY` и список команд.
// Приём взят у самого языка (его `ярлык` и `ярлыки.flang`): тонкая оболочка на
// sh плюс программа на flang.
//
// Список — ПРОГРАММА, а не файл настроек: имена и строки проверены типами, у
// каждой разборной функции есть примеры, а «Сколько ярлыков» несёт число
// обещанием, а не прозой. В оболочке `ярлык` списка НЕТ ни одной строкой.
//
//   ./ярлык                  весь список
//   ./ярлык проверка         выполнить ярлык
//
// ── ЧТО ПЕРЕЕХАЛО СЮДА ИЗ КОНВЕЙЕРА ────────────────────────────────────────
// Две проверки границы между слоями жили только в `.github/workflows`, и
// запустить их у себя было нечем — оставалось верить README на слово. Теперь
// это ярлыки `отказ` и `граница`, и конвейер зовёт их, а не свои шаги:
// проверка, которую нельзя повторить руками, проверкой не считается.
//
// ── Имена файлов ───────────────────────────────────────────────────────────
// `ярлык` и `ярлыки.flang` — единственные два кириллических имени в дереве, и
// взяты они у языка дословно: `./ярлык проверка` — это то, что человек НАБИРАЕТ
// руками, а не внутреннее имя модуля.

объект «Ярлык»
  «имя»: строка
  «команда»: строка
  «зачем»: строка

// Весь список. Порядок здесь — порядок вывода.
//
// Имён модулей здесь нет: проверка ходит по `flang/*.flang`, а печатается ровно
// слой 1 — `flang/env.flang`, и это не список, а единственный печатаемый файл.
// Слой 2 (`flang/read-env.flang`) печатать НЕЛЬЗЯ, и ярлык `граница` этот отказ
// проверяет, а не обходит.
тотальная функция «Все ярлыки»
  возвращает список «Ярлык»
  обеспечивает «ярлыков девять» (длина результат) равен 9
  [запись «Ярлык» с «имя» равным "проверка" и «команда» равным "for m in flang/*.flang tools/licensing.flang ярлыки.flang; do echo \"== $m\"; $FLANG check \"$m\" || exit 1; $FLANG test \"$m\" || exit 1; done" и «зачем» равным "разбор, типы, завершаемость и примеры: оба слоя, сторож, ярлыки",
   запись «Ярлык» с «имя» равным "ведомость" и «команда» равным "$FLANG check --proof flang/env.flang" и «зачем» равным "чем несётся каждое обещание слоя 1: доказано, сетка N или объявлено",
   запись «Ярлык» с «имя» равным "отказ" и «команда» равным "out=$($FLANG check --proof flang/read-env.flang 2>&1); code=$?; echo \"$out\" | tail -3; test $code = 2 || { echo \"ждали код 2, получили $code\" >&2; exit 1; }; echo \"$out\" | grep -q \"ведомость не печатается\" || { echo \"нет объяснения отказа\" >&2; exit 1; }; echo \"отказ на месте: код 2 и объяснение словами\"" и «зачем» равным "у плана ведомости НЕТ, и двоичный говорит это вслух кодом 2",
   запись «Ярлык» с «имя» равным "печать" и «команда» равным "rm -rf out-go out-c; $FLANG emit flang/env.flang --target go --out out-go/env || exit 1; grep -rl flangprogram out-go/env | while read -r x; do sed -i.bak \"s|flangprogram|flangenv|g\" \"$x\" && rm -f \"$x.bak\"; done; ( cd out-go/env && test -z \"$(gofmt -l .)\" && go vet ./... && go build ./... ) || exit 1; $FLANG emit flang/env.flang --target c --out out-c/env || exit 1; make -C out-c/env || exit 1" и «зачем» равным "печать слоя 1 в Go и в C и сборка обеих: gofmt, go vet, go build, cc",
   запись «Ярлык» с «имя» равным "граница" и «команда» равным "d=${TMPDIR:-/tmp}/flang-env-granica; rm -rf $d $d.log; for t in go c rust; do $FLANG emit flang/read-env.flang --target $t --out $d/$t >$d.log 2>&1; tc=$?; test $tc = 1 || { echo \"цель $t: ждали код 1, получили $tc\" >&2; exit 1; }; grep -q FLANG_PLAN_UNSUPPORTED $d.log || { echo \"цель $t: отказа НЕТ — README врёт\" >&2; exit 1; }; echo \"цель $t: отказ на месте, код 1\"; done; $FLANG emit flang/read-env.flang --target js --out $d/js >/dev/null 2>&1; jc=$?; test $jc = 3 || { echo \"цель js: ждали код 3, получили $jc\" >&2; exit 1; }; test -f $d/js/flang_cli.js || { echo \"цель js: файлов нет\" >&2; exit 1; }; echo \"цель js: план напечатан, код 3 — за него печать не ручается\"; rm -rf $d $d.log" и «зачем» равным "план печатают не все цели: go, c, rust отказывают кодом 1, js печатает кодом 3",
   запись «Ярлык» с «имя» равным "план" и «команда» равным "$FLANG check flang/read-env.flang && $FLANG test flang/read-env.flang && $FLANG io flang/read-env.flang" и «зачем» равным "слой 2 читает окружение сам, через flang io",
   запись «Ярлык» с «имя» равным "лицензии" и «команда» равным "cd tools && $FLANG io licensing.flang" и «зачем» равным "лицензионный сторож: SPDX, копилефт, чужие языки",
   запись «Ярлык» с «имя» равным "чисто" и «команда» равным "rm -rf out-go out-c" и «зачем» равным "убрать напечатанное",
   запись «Ярлык» с «имя» равным "всё" и «команда» равным "./ярлык проверка && ./ярлык ведомость && ./ярлык отказ && ./ярлык печать && ./ярлык граница && ./ярлык план && ./ярлык лицензии" и «зачем» равным "весь прогон подряд, в порядке конвейера"]

тотальная функция «Команда ярлыка»
  принимает ярлык: строка
  возвращает строка
  пример «Известное имя отдаёт свою строку»
    дано ярлык равно "чисто"
    ожидается "rm -rf out-go out-c"
  пример «Неизвестное имя — пусто»
    дано ярлык равно "make печать"
    ожидается ""
  пример «Пустое имя — пусто»
    дано ярлык равно ""
    ожидается ""
  свёртка («Все ярлыки») начиная с "" как акк и я
    если (я.«имя») равен ярлык то (я.«команда») иначе акк

// Сколько ярлыков всего. Число живёт здесь, а не в прозе: проза его цитирует.
тотальная функция «Сколько ярлыков»
  возвращает нат
  обеспечивает «ярлыков девять» результат равен 9
  пример «Девять»
    ожидается 9
  длина («Все ярлыки»)

// Отступ до второго столбца. Самое длинное имя — «ведомость», в нём 9 знаков,
// поэтому столбец стоит на 12.
тотальная функция «Отступ»
  принимает имя: строка
  возвращает строка
  обеспечивает «длинное имя получает один пробел» если (длина имя) не меньше 12 то (результат равен " ") иначе да
  пример «Короткое имя дополняется до столбца»
    дано имя равно "чисто"
    ожидается "       "
  пример «Имя длиннее столбца получает один пробел, а не отрицательную длину»
    дано имя равно "очень длинное имя ярлыка"
    ожидается " "
  если (длина имя) не меньше 12
    то " "
    иначе подстрока "            " с 1 по (12 минус (длина имя))

// Весь список одной строкой: имя, отступ, зачем. Печатает его оболочка.
тотальная функция «Перечень»
  возвращает строка
  обеспечивает «в перечне столько же строк, сколько ярлыков» (длина (разделить результат по "\n")) равен («Сколько ярлыков»)
  соединить (отобразить («Все ярлыки») как я → (соединить [я.«имя», («Отступ» от (я.«имя»)), я.«зачем»] по "")) по "\n"
